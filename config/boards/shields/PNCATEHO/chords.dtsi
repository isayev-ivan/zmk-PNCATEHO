#include "chord_macros.dtsi"

/* Одно комбо зеркалится на две стороны
 * - имя, - поведение при нажатии, - на каких клавишах слева, - справа, - на каких слоях применять
 */ 
// переключения языка
COMBO_MIRROR_LAYERS(lang_ru, &ht_combo_ru LS(LGUI) 0, LOT LIT, ROT RIT, RU_L)
COMBO_MIRROR_LAYERS(lang_en, &ht_combo_en LS(LGUI) 0, LOT LIT, ROT RIT, ENG_L)

/* Комбо без базового tap поведения (чтобы не конфликтовать с hold-cлоями, tap поведение прописано в слое
 * - имя, - поведение с cогнутым thumb, - поведение с разогнутым thumb, - с двумя thumb, - клавиши слева, - клавиши справа
*/ 
TCOMBO_NO_BASE(b , &kp LEFT    , &kp LS(B)    , &kp LS(LEFT)  , TLP          , TRP  )
TCOMBO_NO_BASE(j , &kp RIGHT   , &kp LS(J)    , &kp LS(RIGHT) , TLI          , TRI  )
TCOMBO_NO_BASE(h , &sk LGUI    , &kp LS(H)    , &kp HOME      , BLP          , BRP  )
TCOMBO_NO_BASE(y , &sk LSHIFT  , &kp LS(Y)    , &kp END       , BLI          , BRI  )
TCOMBO_NO_BASE(f , &kp UP      , &kp LS(F)    , &kp LS(UP)    , TLR          , TRR  )
TCOMBO_NO_BASE(c , &sk LALT    , &kp LS(C)    , &kp PG_UP     , BLR          , BRR  )

//     name,       press,        curved,        splayed,       both,           chord left,    chord right
// одноклавишные
TCOMBO(t         , &kp T       , &kp LS(T)    , &kp DOWN     , &kp LS(DOWN)  , TLM          , TRM          )
TCOMBO(n         , &kp N       , &kp LS(N)    , &sk LCTRL    , &kp PG_DN     , BLM          , BRM          )
// двуклавишные
TCOMBO(d         , &kp D       , &kp LS(D)    , &kp N1       , &kp F1        , TLP TLI      , TRP TRI      )
TCOMBO(k         , &kp K       , &kp LS(K)    , &kp N2       , &kp F2        , BLP BLI      , BRP BRI      )
TCOMBO(r         , &kp R       , &kp LS(R)    , &kp N3       , &kp F3        , BLP BLR      , BRP BRR      )
TCOMBO(v         , &kp V       , &kp LS(V)    , &kp N4       , &kp F4        , BLM BLI      , BRM BRI      )
TCOMBO(l         , &kp L       , &kp LS(L)    , &kp N5       , &kp F5        , TLP TLR      , TRP TRR      )
TCOMBO(g         , &kp G       , &kp LS(G)    , &kp N6       , &kp F6        , TLM TLI      , TRM TRI      )
TCOMBO(e         , &kp E       , &kp LS(E)    , &kp N7       , &kp F7        , BLR BLM      , BRR BRM      )
TCOMBO(z         , &kp Z       , &kp LS(Z)    , &kp N8       , &kp F8        , TLR TLM      , TRR TRM      )
TCOMBO(s         , &kp S       , &kp LS(S)    , &kp N9       , &kp F9        , BLP BLM      , BRP BRM      )
TCOMBO(m         , &kp M       , &kp LS(M)    , &kp N0       , &kp F10       , BLR BLI      , BRR BRI      )
TCOMBO(u         , &kp U       , &kp LS(U)    , &kp EXCL     , &kp F11       , TLP TLM      , TRP TRM      )
TCOMBO(p         , &kp P       , &kp LS(P)    , &kp AT       , &kp F12       , TLR TLI      , TRR TRI      )
TCOMBO(comma     , &kp COMMA   , &kp LS(COMMA), &kp HASH     , &none         , TLP BLI      , TRP BRI      )
TCOMBO(x         , &kp X       , &kp LS(X)    , &kp DLLR     , &none         , BLP TLI      , BRP TRI      )
TCOMBO(q         , &kp Q       , &kp LS(Q)    , &kp PRCNT    , &none         , TLP BLM      , TRP BRM      )
TCOMBO(lbkt      , &kp LBKT    , &kp LS(LBKT) , &kp CARET    , &none         , BLR TLI      , BRR TRI      )
TCOMBO(semi      , &kp SEMI    , &kp LS(SEMI) , &kp AMPS     , &none         , BLP TLM      , BRP TRM      )
TCOMBO(i         , &kp I       , &kp LS(I)    , &kp STAR     , &none         , TLR BLI      , TRR BRI      )
TCOMBO(dot       , &kp DOT     , &kp LS(DOT)  , &kp LPAR     , &none         , TLP BLR      , TRP BRR      )
TCOMBO(w         , &kp W       , &kp LS(W)    , &kp RPAR     , &none         , TLI BLM      , TRI BRM      )
TCOMBO(o         , &kp O       , &kp LS(O)    , &kp SLASH    , &none         , TLR BLM      , TRR BRM      )
TCOMBO(sqt       , &kp SQT     , &kp LS(SQT)  , &kp QMARK    , &none         , TLM BLR      , TRM BRR      )
TCOMBO(a         , &kp A       , &kp LS(A)    , &kp MINUS    , &none         , TLM BLI      , TRM BRI      )
TCOMBO(rbkt      , &kp RBKT    , &kp LS(RBKT) , &kp UNDER    , &none         , TLR BLP      , TRR BRP      )

TCOMBO(del       , &kp DEL     , &none        , &kp LC(DEL)  , &none         , TLR BLR      , TRR BRR      )
TCOMBO(esc       , &kp ESC     , &none        , &kp N1       , &none         , TLM BLM      , TRM BRM      )
TCOMBO(tab       , &kp TAB     , &kp LA(TAB)  , &kp LC(TAB)  , &none         , TLP BLP      , TRP BRP      )
TCOMBO(enter     , &kp ENTER   , &kp LS(ENTER), &none        , &none         , TLI BLI      , TRI BRI      )

// трехклавишные
TCOMBO(grave     , &kp GRAVE   , &kp LS(GRAVE), &kp EQUAL    , &none         , BLR BLM BLI  , BRR BRM BRI  )
TCOMBO(nubs      , &kp NUBS    , &kp LS(NUBS) , &kp PLUS     , &none         , TLR TLM TLI  , TRR TRM TRI  )
TCOMBO(mg_comma  , &mg_comma   , &kp SYM_COLON , &mg_dot      , &kp SYM_SEMICOL  , TLP TLR TLM  , TRP TRR TRM  )
TCOMBO(minus_dash, &kp SYM_MINUS  , &kp UNDER , &kp SYM_MATHMIN   , &kp PIPE     , BLP BLR BLM  , BRP BRR BRM  )

// четырехклавишные
TCOMBO(boot      , &none       , &none        , &ext_power EP_OFF, &bootloader   , TLP TLR TLM TLI, TRP TRR TRM TRI)
TCOMBO(bt        , &bt BT_SEL 0, &bt BT_SEL 1 , &bt BT_SEL 2 , &bt BT_CLR        , BLP BLR BLM BLI, BRP BRR BRM BRI)


// Hold Numbers Layer Combos — двукнопия
COMBO_MIRROR_LAYERS(num_8, &kp N8, TLR TLM, TRR TRM, HOLD_NUM_L)
COMBO_MIRROR_LAYERS(num_7, &kp N7, TLM TLI, TRM TRI, HOLD_NUM_L)
COMBO_MIRROR_LAYERS(num_9, &kp N9, BLM BLI, BRM BRI, HOLD_NUM_L)

// Hold Numbers Layer Combos — комбо с thumb
TCOMBO_NO_BASE_LAYERS(num_2, &kp SYM_PERCENT, &kp SYM_NUMERO,  &none       , TLM, TRM, HOLD_NUM_L)
TCOMBO_NO_BASE_LAYERS(num_1, &kp SYM_STAR,    &kp SYM_PLUS,    &none       , TLI, TRI, HOLD_NUM_L)
TCOMBO_NO_BASE_LAYERS(num_5, &kp SYM_DOLLAR,  &kp SYM_RUBLE,   &none       , BLM, BRM, HOLD_NUM_L)
TCOMBO_NO_BASE_LAYERS(num_4, &kp SYM_CARET,   &kp SYM_MATHMIN, &kp SYM_DOT , BLI, BRI, HOLD_NUM_L)

// Hold symbols layer combos
TCOMBO_NO_BASE_LAYERS(sym_at,    &kp SYM_DOLLAR, &kp SYM_RUBLE,  &kp SYM_AMP,    TLP, TRP, HOLD_SYM_L)
TCOMBO_NO_BASE_LAYERS(sym_lpar,  &kp SYM_LBKT,   &kp SYM_LGUIL,  &kp SYM_LBRACE, TLR, TRR, HOLD_SYM_L)
TCOMBO_NO_BASE_LAYERS(sym_rpar,  &kp SYM_RBKT,   &kp SYM_RGUIL,  &kp SYM_RBRACE, TLM, TRM, HOLD_SYM_L)
TCOMBO_NO_BASE_LAYERS(sym_hash,  &kp SYM_TILDE,  &kp SYM_GRAVE,  &kp SYM_EMPH,   BLP, BRP, HOLD_SYM_L)
TCOMBO_NO_BASE_LAYERS(sym_quest, &kp SYM_EXCL,   &kp SYM_APOS,   &kp SYM_LT,     BLR, BRR, HOLD_SYM_L)
TCOMBO_NO_BASE_LAYERS(sym_slash, &kp SYM_BSLH,   &kp SYM_DQUOTE, &kp SYM_GT,     BLM, BRM, HOLD_SYM_L)

// Hold navigation layer combos
TCOMBO_NO_BASE_LAYERS(nav_up,    &none, &kp SYM_UP,    &none, TLM, TRM, HOLD_NAV_L)
TCOMBO_NO_BASE_LAYERS(nav_left,  &none, &kp SYM_LEFT,  &none, BLR, BRR, HOLD_NAV_L)
TCOMBO_NO_BASE_LAYERS(nav_down,  &none, &kp SYM_DOWN,  &none, BLM, BRM, HOLD_NAV_L)
TCOMBO_NO_BASE_LAYERS(nav_right, &none, &kp SYM_RIGHT, &none, BLI, BRI, HOLD_NAV_L)

COMBO_MIRROR_LAYERS(hb_dquote, &kp SYM_DQUOTE, TLM TLI, TRM TRI, HOLD_BRACKETS_L)
COMBO_MIRROR_LAYERS(hb_apos,   &kp SYM_APOS,   BLM BLI, BRM BRI, HOLD_BRACKETS_L)
COMBO_MIRROR_LAYERS(hb_pipe,   &kp PIPE,       LIT LOT, RIT ROT, HOLD_BRACKETS_L)

COMBO_MIRROR_LAYERS(ht_pipe,   &kp PIPE,       TLM TLI, TRM TRI, HOLD_TYPO_L)
COMBO_MIRROR_LAYERS(ht_tilde,  &kp SYM_TILDE,  BLM BLI, BRM BRI, HOLD_TYPO_L)

COMBO_MIRROR_LAYERS_IDLE(lock_nav,   &tog NAV_L,   TLM BLR BLI, TRM BRR BRI, RU_L ENG_L NAV_L MOUSE_L, 150)
COMBO_MIRROR_LAYERS_IDLE(lock_mouse, &tog MOUSE_L, TLR BLM TLI, TRR BRM TRI, RU_L ENG_L NAV_L MOUSE_L, 150)

COMBO_MIRROR_LAYERS(hm_shot_screen, &kp LG(LS(N4)), TLR TLM, TRR TRM, HOLD_MEDIA_L)
COMBO_MIRROR_LAYERS(hm_joxi,        &kp LG(LS(N6)), BLR BLM, BRR BRM, HOLD_MEDIA_L)
