#ifndef PNCATEHO_CHORD_MACROS_DTSI
#define PNCATEHO_CHORD_MACROS_DTSI

/**
 * Базовый абстрактный макрос для создания комбо-аккордов с thumb-модификаторами (без обычного клика).
 * Генерирует 6 комбо: для левой и правой руки, с согнутым (LIT/RIT), вытянутым (LOT/ROT) и обоими большими пальцами.
 * Намеренно не создает базовые "одиночные" комбо, чтобы не перекрывать поведение удержания (Hold) для Layer-Tap клавиш.
 * 
 * @param NAME Имя комбо (используется для генерации уникальных названий нод)
 * @param LAYER Слой, на котором должны работать эти комбо
 * @param CURVED_BINDINGS Действие при нажатии аккорда + согнутый большой палец
 * @param SPLAYED_BINDINGS Действие при нажатии аккорда + вытянутый большой палец
 * @param BOTH_BINDINGS Действие при нажатии аккорда + оба больших пальца
 * @param LEFT_KEYPOS Позиции клавиш левого аккорда
 * @param RIGHT_KEYPOS Позиции клавиш правого аккорда
 */
#define LAYER_TCOMBO_NO_BASE(NAME, LAYER, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
combo_lo_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <SPLAYED_BINDINGS>; \
        key-positions = <LEFT_KEYPOS LOT>; \
        layers = <LAYER>; \
}; \
combo_li_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <CURVED_BINDINGS>; \
        key-positions = <LEFT_KEYPOS LIT>; \
        layers = <LAYER>; \
}; \
combo_lb_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BOTH_BINDINGS>; \
        key-positions = <LEFT_KEYPOS LIT LOT>; \
        layers = <LAYER>; \
}; \
combo_ro_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <SPLAYED_BINDINGS>; \
        key-positions = <RIGHT_KEYPOS ROT>; \
        layers = <LAYER>; \
}; \
combo_ri_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <CURVED_BINDINGS>; \
        key-positions = <RIGHT_KEYPOS RIT>; \
        layers = <LAYER>; \
}; \
combo_rb_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BOTH_BINDINGS>; \
        key-positions = <RIGHT_KEYPOS RIT ROT>; \
        layers = <LAYER>; \
};

/**
 * Полный абстрактный макрос для создания комбо-аккордов с thumb-модификаторами.
 * Включает в себя функционал LAYER_TCOMBO_NO_BASE, но дополнительно генерирует 
 * 2 базовых "одиночных" комбо (для левой и правой руки без участия больших пальцев).
 * Итого генерирует 8 комбо.
 * 
 * @param BINDINGS Действие при обычном нажатии аккорда (без больших пальцев)
 * (Остальные параметры аналогичны LAYER_TCOMBO_NO_BASE)
 */
#define LAYER_TCOMBO(NAME, LAYER, BINDINGS, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        layers = <LAYER>; \
}; \
combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        layers = <LAYER>; \
}; \
LAYER_TCOMBO_NO_BASE(NAME, LAYER, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS)

/**
 * Обертка над LAYER_TCOMBO_NO_BASE для использования на дефолтных слоях (COMBO_LAYERS).
 * Применяется для клавиш, которые уже имеют поведение Layer-Tap (например &lt) на базовом слое.
 */
#define TCOMBO_NO_BASE(NAME, BINDINGS, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    LAYER_TCOMBO_NO_BASE(NAME, COMBO_LAYERS, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS)

/**
 * Обертка над LAYER_TCOMBO для использования на дефолтных слоях (COMBO_LAYERS).
 * Стандартный макрос для большинства аккордов клавиатуры (генерирует 8 комбинаций).
 */
#define TCOMBO(NAME, BINDINGS, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    LAYER_TCOMBO(NAME, COMBO_LAYERS, BINDINGS, CURVED_BINDINGS, SPLAYED_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS)

/**
 * 
 * Генератор 4-состояний mod-morph:
 * 1) base (без модов)
 * 2) cmd (LGUI/RGUI)
 * 3) shift (LSHIFT/RSHIFT)
 * 4) cmd+shift
 *
 * Важно: behavior-mod-morph в ZMK не ограничивается слоями напрямую.
 * Ограничение по слоям достигается тем, где именно вы ставите `&NAME` в keymap.
 * Внешний (публичный) behavior всегда вызывается как `&NAME`.
 * Внутренние ноды `NAME_shift` и `NAME_cmd_shift` служебные.
 *
 * @param NAME Базовое имя behavior-нод
 * @param BASE_BINDING Биндинг без модификаторов
 * @param CMD_BINDING Биндинг при зажатом Cmd (GUI)
 * @param SHIFT_BINDING Биндинг при зажатом Shift
 * @param CMD_SHIFT_BINDING Биндинг при зажатых Cmd+Shift
 */
#define MOD_MPH(NAME, BASE_BINDING, CMD_BINDING, SHIFT_BINDING, CMD_SHIFT_BINDING) \
NAME##_base_masked: NAME##_base_masked { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <BASE_BINDING>, <BASE_BINDING>; \
	mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>; \
}; \
NAME##_cmd_masked: NAME##_cmd_masked { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <CMD_BINDING>, <CMD_BINDING>; \
	mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>; \
}; \
NAME##_shift_masked: NAME##_shift_masked { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <SHIFT_BINDING>, <SHIFT_BINDING>; \
	mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>; \
}; \
NAME##_cmd_shift_masked: NAME##_cmd_shift_masked { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <CMD_SHIFT_BINDING>, <CMD_SHIFT_BINDING>; \
	mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>; \
}; \
NAME##_shift: NAME##_shift { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <&NAME##_base_masked>, <&NAME##_shift_masked>; \
	mods = <(MOD_LSFT|MOD_RSFT)>; \
}; \
NAME##_cmd_shift: NAME##_cmd_shift { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <&NAME##_cmd_masked>, <&NAME##_cmd_shift_masked>; \
	mods = <(MOD_LSFT|MOD_RSFT)>; \
}; \
NAME: NAME { \
	compatible = "zmk,behavior-mod-morph"; \
	#binding-cells = <0>; \
	bindings = <&NAME##_shift>, <&NAME##_cmd_shift>; \
	mods = <(MOD_LGUI|MOD_RGUI)>; \
};

/**
 * Макрос для создания простых зеркальных комбо (одно действие, две стороны).
 * Удобно для комбо, не требующих thumb-модификаторов (например, 4, 7, 8, 9 на слое цифр).
 * 
 * @param NAME Базовое имя комбо (будут созданы combo_l_NAME и combo_r_NAME)
 * @param BINDINGS Действие при срабатывании комбо
 * @param LEFT_KEYPOS Позиции клавиш на левой половине
 * @param RIGHT_KEYPOS Позиции клавиш на правой половине
 * @param LAYERS Слой(и), на котором(ых) работает комбо
 */
#define COMBO_MIRROR_LAYERS(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS, LAYERS) \
combo_l_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <LEFT_KEYPOS>; \
	layers = <LAYERS>; \
}; \
combo_r_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <RIGHT_KEYPOS>; \
	layers = <LAYERS>; \
};

/**
 * Вариация COMBO_MIRROR_LAYERS с дополнительным параметром require-prior-idle-ms.
 * Полезно для комбо, которые могут случайно срабатывать при быстрой печати.
 * 
 * @param IDLE_MS Время (в мс), которое клавиатура должна бездействовать перед срабатыванием комбо
 */
#define COMBO_MIRROR_LAYERS_IDLE(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS, LAYERS, IDLE_MS) \
combo_l_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <LEFT_KEYPOS>; \
	layers = <LAYERS>; \
	require-prior-idle-ms = <IDLE_MS>; \
}; \
combo_r_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <RIGHT_KEYPOS>; \
	layers = <LAYERS>; \
	require-prior-idle-ms = <IDLE_MS>; \
};

#endif
