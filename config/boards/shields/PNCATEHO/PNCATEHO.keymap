#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

&mmv {
  time-to-max-speed-ms = <500>;
  acceleration-exponent = <1>;
};

&msc {
  time-to-max-speed-ms = <500>;
  acceleration-exponent = <1>;
};

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS RU_L ENG_L
#define STICKY_TIMEOUT 500

// LAYERS
#define RU_L 0
#define ENG_L 1
#define NAV_L 2
#define MOUSE_L 3
#define HOLD_NAV_L 4
#define HOLD_MEDIA_L 5

// LEFT SIDE
#define TLP 0 // TOP
#define TLR 1 // TOP
#define TLM 2 // TOP
#define TLI 3 // TOP
#define BLP 8 // BOTTOM
#define BLR 9 // BOTTOM
#define BLM 10 // BOTTOM
#define BLI 11 // BOTTOM
#define LOT 16 // O-THUMB
#define LIT 17 // I-THUMB

// RIGHT SIDE
#define TRP 7 // TOP
#define TRR 6 // TOP
#define TRM 5 // TOP
#define TRI 4 // TOP
#define BRP 15 // BOTTOM
#define BRR 14 // BOTTOM
#define BRM 13 // BOTTOM
#define BRI 12 // BOTTOM
#define ROT 19 // O-THUMB
#define RIT 18 // I-THUMB

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

/ {
  macros {
    // Магическая точка: ставит точку и пробел, зажимая левую Shift
    mg_dot: mg_dot {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp RA(N7) &kp SPACE &sk LSHFT>;
      wait-ms = <5>;
      tap-ms = <5>;
    };

    // Магическая запятая: ставит запятую и пробел
    mg_comma: mg_comma {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp RA(N6) &kp SPACE>;
      wait-ms = <5>;
      tap-ms = <5>;
    };

    // Переключение языка на английский (включает слой 1 поверх 0)
    mac_to_en: mac_to_en {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp LS(LC(LA(N1))) &tog ENG_L>;
      wait-ms = <5>;
      tap-ms = <5>;
    };

    // Переключение языка на русский (выключает слой 1, возвращаясь к 0)
    mac_to_ru: mac_to_ru {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp LS(LC(LA(N2))) &tog RU_L>;
      wait-ms = <5>;
      tap-ms = <5>;
    };

  };

  behaviors {
      // Ставит вопросительный знак, а с зажатием Shift - восклицательный знак
      quest_excl: quest_excl {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp RA(LS(SLASH))>, <&kp EXCL>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // Ставит скобку "(", а с зажатием Shift - "<"
      bracket_left: bracket_left {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp LPAR>, <&kp RA(LS(N6))>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          keep-mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      // Ставит скобку ")", а с зажатием Shift - ">"
      bracket_right: bracket_right {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp RPAR>, <&kp RA(LS(N7))>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          keep-mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // Ставит ",", а с зажатием Shift - "→"
      comma_right: comma_right {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp RA(N6)>, <&kp RA(L)>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // Ставит "-", а с зажатием Shift - "↓"
      minus_down: minus_down {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp MINUS>, <&kp RA(K)>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      // Ставит "#", а с зажатием Shift - "↑"
      up_hash: up_hash {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp HASH>, <&kp RA(I)>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      // Ставит "=", а с зажатием Shift - "←"
      equal_left: equal_left {
          compatible = "zmk,behavior-mod-morph";
          bindings = <&kp EQUAL>, <&kp RA(J)>;

          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // --- Настройки Hold-Tap для Thumb-клавиш и Комбо ---
      // Подробное описание параметров см. в docs/hold_tap_settings.md
      // tapping-term-ms: время удержания для срабатывания Hold (200мс)
      // quick-tap-ms: окно для двойного клика, чтобы "зажать" Tap-клавишу (например, Backspace) (175мс)
      // require-prior-idle-ms: защита от случайных модов при быстрой печати (150мс)
      // flavor "balanced": корректное разрешение конфликтов при перекатах пальцев
      ht_inner: ht_inner {
          compatible = "zmk,behavior-hold-tap";
          label = "HT_INNER";
          #binding-cells = <0>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp LSHIFT>, <&kp BSPC>;
      };

      ht_outer: ht_outer {
          compatible = "zmk,behavior-hold-tap";
          label = "HT_OUTER";
          #binding-cells = <0>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp LGUI>, <&kp SPACE>;
      };

      ht_combo_ru: ht_combo_ru {
          compatible = "zmk,behavior-hold-tap";
          label = "HT_COMBO_RU";
          #binding-cells = <0>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp LS(LGUI)>, <&mac_to_en>;
      };

      ht_combo_en: ht_combo_en {
          compatible = "zmk,behavior-hold-tap";
          label = "HT_COMBO_EN";
          #binding-cells = <0>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          bindings = <&kp LS(LGUI)>, <&mac_to_ru>;
      };

      /*
      to_en_raise: to_en_raise {
          compatible = "zmk,behavior-hold-tap";
          label = "TO_EN_RAISE";
          bindings = <&mo>, <&mac_to_en>;

          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "balanced";
      };

      to_ru_raise: to_ru_raise {
          compatible = "zmk,behavior-hold-tap";
          label = "TO_RU_RAISE";
          bindings = <&mo>, <&mac_to_ru>;

          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "balanced";
      };
      */
  };

  combos {
    compatible = "zmk,combos";
    #include "chords.dtsi"
  };

  keymap {
    compatible = "zmk,keymap";

    ru_layer {
      bindings = <
        &kp B             &none            &none            &kp J                       &kp J              &none            &none            &kp B
        &lt HOLD_NAV_L H  &none            &none            &lt HOLD_MEDIA_L Y          &lt HOLD_MEDIA_L Y &none            &none            &lt HOLD_NAV_L H
                                                            &ht_outer        &ht_inner  &ht_inner          &ht_outer
      >;
    };

    eng_layer {
      bindings = <
        &trans            &trans           &trans           &trans                      &trans             &trans           &trans           &trans
        &trans            &trans           &trans           &trans                      &trans             &trans           &trans           &trans
                                                            &trans           &trans     &trans             &trans
      >;
    };

    nav_layer {
      bindings = <
        &kp PG_UP         &kp HOME         &kp UP           &kp END                     &kp HOME           &kp UP           &kp END          &kp PG_UP
        &kp PG_DN         &kp LEFT         &kp DOWN         &kp RIGHT                   &kp LEFT           &kp DOWN         &kp RIGHT        &kp PG_DN
                                                            &trans           &trans     &trans             &trans
      >;
    };

    mouse_layer {
      bindings = <
        &msc SCRL_UP      &mkp RCLK        &mmv MOVE_UP     &mkp LCLK                   &mkp LCLK          &mmv MOVE_UP     &mkp RCLK        &msc SCRL_UP
        &msc SCRL_DOWN    &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT             &mmv MOVE_LEFT     &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &msc SCRL_DOWN
                                                            &trans           &trans     &trans             &trans
      >;
    };

    hold_nav_layer {
      bindings = <
        &trans            &kp HOME         &kp UP           &kp END                     &kp END            &kp UP           &kp HOME         &trans
        &trans            &kp LEFT         &kp DOWN         &kp RIGHT                   &kp RIGHT          &kp DOWN         &kp LEFT         &trans
                                                            &trans           &trans     &trans             &trans
      >;
    };

    hold_media_layer {
      bindings = <
        &kp C_MUTE        &kp C_PREV       &kp C_VOL_UP     &trans                      &trans             &kp C_VOL_UP     &kp C_PREV       &kp C_MUTE
        &kp C_PP          &kp C_NEXT       &kp C_VOL_DN     &trans                      &trans             &kp C_VOL_DN     &kp C_NEXT       &kp C_PP
                                                            &trans           &trans     &trans             &trans
      >;
    };
  };
};
